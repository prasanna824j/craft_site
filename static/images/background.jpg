<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f9f9f9;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e6e6e6;stop-opacity:1" />
    </linearGradient>
    <pattern id="pattern1" width="60" height="60" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="30" height="30" fill="#f0f0f0" x="0" y="0"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#grad1)"/>
  <rect width="100%" height="100%" fill="url(#pattern1)" opacity="0.3"/>
  <g opacity="0.5">
    <circle cx="400" cy="300" r="250" fill="#e1e7f5" opacity="0.4"/>
    <circle cx="1600" cy="800" r="300" fill="#e1e7f5" opacity="0.4"/>
    <circle cx="1000" cy="500" r="150" fill="#e1e7f5" opacity="0.2"/>
  </g>
</svg>